# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# KAGGLE_CONFIG: Server-side credentials and target GPU kernel slugs for ChronosBox reconciliation
KAGGLE_USERNAME="RaviiKishore07"
KAGGLE_KEY="YOUR_KAGGLE_API_KEY"
KAGGLE_GPU_KERNEL_SLUG="raviikishore07/project-zero-ram-fdtd-gpu"
KAGGLE_ALT_KERNEL_SLUG="raviikishore07/kaggle-v7-production-t4"

# DURABLE_STATE_ENGINE: PostgreSQL (pgvector) & Redis checkpointing endpoints
POSTGRES_HOST="localhost"
POSTGRES_DB="chronosbox_state"
REDIS_CACHE_URI="redis://localhost:6379/0"

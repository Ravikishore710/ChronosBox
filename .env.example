# GEMINI_API_KEY: Required for server-side Gemini AI durable agent steps.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where ChronosBox is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL / POSTGRES_HOST: PostgreSQL 16+ connection string (with pgvector extension).
DATABASE_URL="postgresql://user:password@localhost:5432/chronosbox?sslmode=require"
POSTGRES_HOST="postgresql://user:password@localhost:5432/chronosbox?sslmode=require"
POSTGRES_DB="chronosbox"

# REDIS_CACHE_URI: Optional Redis / Upstash cache endpoint (falls back to Adaptive L1 LRU cache).
REDIS_CACHE_URI="redis://localhost:6379/0"

# KAGGLE_USERNAME & KAGGLE_KEY: Credentials for Kaggle GPU Kernel Bearer API reconciliation.
KAGGLE_USERNAME="RaviiKishore07"
KAGGLE_KEY="KGAT_YOUR_KAGGLE_BEARER_TOKEN"
KAGGLE_GPU_KERNEL_SLUG="raviikishore07/kaggle-v7-production-t4"
KAGGLE_ALT_KERNEL_SLUG="raviikishore07/nexoralm-300m-pretraining"

# Runtime & Vite server flags
DISABLE_HMR="false"
NODE_ENV="development"
LOG_LEVEL="info"
PORT="3000"
